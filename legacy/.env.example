# Legacy container ports (host-side). Override in legacy/.env.
TN3270_PORT=3270
HERCULES_CONSOLE_PORT=8038

# Demo mainframe user. The TK4- default password is in its README (README_MVS_TK4-_v1.00.txt).
# Batch jobs MUST carry USER/PASSWORD on the JOB card (RAKF), or they run as PROD.
MVS_USER=HERC01
MVS_PASSWORD=changeme
