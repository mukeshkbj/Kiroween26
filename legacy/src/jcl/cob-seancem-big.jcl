//CBSEANB JOB (ACCT),'KICKS COB BIG',CLASS=A,MSGCLASS=A,REGION=8192K,
//         USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//* Authorized one-shot retry of the KICKS COBOL compile with raised storage.
//* We inline the KICKS single-pass steps (not the KIKCOBCL proc) so we can set
//* REGION=8192K and SIZE=4096K/BUF=2048K on the IKFCBL00 step, which the proc
//* hardcodes lower. If IKFCBL00 still abends S0C4 this is a genuine tool limit
//* in this TK4- build and the stand-in fallback stands.
//* COPY: concatenate nothing; the KICKS preprocessor reads the program source.
//PP2    EXEC PGM=KIKPPCOB,PARM='-v -t'
//STEPLIB  DD DSN=HERC01.KICKSSYS.V1R5M0.SKIKLOAD,DISP=SHR
//SYSPRINT DD DSN=&&PPIN,DISP=(,PASS),UNIT=SYSDA,
//            SPACE=(800,(500,100)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSTERM  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSLIB   DD DISP=SHR,DSN=HERC01.KICKS.V1R5M0.COBCOPY
//         DD DISP=SHR,DSN=HERC01.KICKSSYS.V1R5M0.COBCOPY
//SYSIN    DD DISP=SHR,DSN=HERC01.KICKS.V1R5M0.COB(SEANCEM)
//COB2   EXEC PGM=IKFCBL00,REGION=8192K,COND=(5,LT,PP2),
//         PARM='NODECK,LOAD,SIZE=4096K,BUF=2048K,SUPMAP,LIB'
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSLIB   DD DISP=SHR,DSN=HERC01.KICKS.V1R5M0.COBCOPY
//         DD DISP=SHR,DSN=HERC01.KICKSSYS.V1R5M0.COBCOPY
//SYSLIN   DD DSN=&&OBJ,DISP=(MOD,PASS),UNIT=SYSDA,
//            SPACE=(80,(250,100))
//SYSUT1   DD UNIT=SYSDA,SPACE=(460,(350,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(460,(350,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(460,(350,100))
//SYSUT4   DD UNIT=SYSDA,SPACE=(460,(350,100))
//SYSIN    DD DISP=(OLD,DELETE),DSN=&&PPIN
//LKED   EXEC PGM=IEWL,PARM='LIST,XREF,LET',COND=(5,LT,COB2)
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//         DD DDNAME=SYSIN
//SYSLMOD  DD DSN=HERC01.KICKS.V1R5M0.KIKRPL(SEANCEM),DISP=SHR
//SYSLIB   DD DISP=SHR,DSN=SYS1.COBLIB
//SKIKLOAD DD DISP=SHR,DSN=HERC01.KICKSSYS.V1R5M0.SKIKLOAD
//KIKRPL   DD DISP=SHR,DSN=HERC01.KICKSSYS.V1R5M0.KIKRPL
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(200,20))
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 INCLUDE SKIKLOAD(KIKCOBGL)
 ENTRY SEANCEM
/*
//
