//TSOREQ  JOB (ACCT),'TSO REQUEST CARDS',CLASS=A,MSGCLASS=A,
//         USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//* Request cards for tso-seancsvc.jcl: HERC01.SEANCE.TSOREQ(LOOKUP|LIST).
//DEL     EXEC PGM=IEFBR14
//D       DD DSN=HERC01.SEANCE.TSOREQ,DISP=(MOD,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,1)
//LOAD    EXEC PGM=IEBUPDTE,PARM=NEW
//SYSPRINT DD SYSOUT=*
//SYSUT2   DD DSN=HERC01.SEANCE.TSOREQ,DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(1,1,2)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSIN    DD DATA
./ ADD NAME=LOOKUP
L P0000003
./ ADD NAME=LIST
A
./ ENDUP
/*
//
