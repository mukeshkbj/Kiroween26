//RCVKICK2 JOB (ACCT),'KICKS UNPACK',CLASS=A,MSGCLASS=A,REGION=4096K,
//         USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//*
//* Our own unpack job (the KICKS-supplied one is KICKS-owned and is not
//* copied into the repo). Receives each member of HERC01.KICKS.V1R5M0.INSTALL
//* (the XMI loaded by recv370-kicks.jcl) into its own dataset.
//RECV    PROC UID=HERC01,MEM=DUMMY,MEM2=DUMMY,TRK=30,MLQ=KICKS
//RECV370 EXEC PGM=RECV370
//RECVLOG  DD  SYSOUT=*
//XMITIN   DD  DSN=&UID..KICKS.V1R5M0.INSTALL(&MEM),DISP=SHR
//SYSPRINT DD  SYSOUT=*
//SYSUT1   DD  DSN=&&SYSUT1,UNIT=SYSALLDA,
//             SPACE=(TRK,(300,60)),DISP=(NEW,DELETE,DELETE)
//SYSUT2   DD  DSN=&UID..&MLQ..V1R5M0.&MEM2,UNIT=SYSALLDA,
//             SPACE=(TRK,(&TRK,&TRK,100)),DISP=(NEW,CATLG,DELETE)
//SYSIN    DD  DUMMY
// PEND
//*//HCB2     EXEC RECV,MEM=HCB2,MEM2=CB2,TRK=150,MLQ=KICKS
//HCOB     EXEC RECV,MEM=HCOB,MEM2=COB,TRK=150,MLQ=KICKS
//HCOBCOPY EXEC RECV,MEM=HCOBCOPY,MEM2=COBCOPY,TRK=150,MLQ=KICKS
//HGCC     EXEC RECV,MEM=HGCC,MEM2=GCC,TRK=150,MLQ=KICKS
//HGCCCOPY EXEC RECV,MEM=HGCCCOPY,MEM2=GCCCOPY,TRK=150,MLQ=KICKS
//HINSTLIB EXEC RECV,MEM=HINSTLIB,MEM2=INSTLIB,TRK=30,MLQ=KICKS
//HKIKRPL  EXEC RECV,MEM=HKIKRPL,MEM2=KIKRPL,TRK=150,MLQ=KICKS
//HMAPSRC  EXEC RECV,MEM=HMAPSRC,MEM2=MAPSRC,TRK=45,MLQ=KICKS
//HOPIDS   EXEC RECV,MEM=HOPIDS,MEM2=OPIDS,TRK=15,MLQ=KICKS
//HSPUFI   EXEC RECV,MEM=HSPUFI,MEM2='SPUFI.IN',TRK=15,MLQ=KICKS
//SCMDPROC EXEC RECV,MEM=SCMDPROC,MEM2=CLIST,TRK=15,MLQ=KICKSSYS
//SCOB     EXEC RECV,MEM=SCOB,MEM2=COB,TRK=45,MLQ=KICKSSYS
//SCOBCOPY EXEC RECV,MEM=SCOBCOPY,MEM2=COBCOPY,TRK=60,MLQ=KICKSSYS
//SDOC     EXEC RECV,MEM=SDOC,MEM2=DOC,TRK=15,MLQ=KICKSSYS
//SGCC     EXEC RECV,MEM=SGCC,MEM2=GCC,TRK=15,MLQ=KICKSSYS
//SGCCCOPY EXEC RECV,MEM=SGCCCOPY,MEM2=GCCCOPY,TRK=60,MLQ=KICKSSYS
//SINSTLIB EXEC RECV,MEM=SINSTLIB,MEM2=INSTLIB,TRK=30,MLQ=KICKSSYS
//SKIKRPL  EXEC RECV,MEM=SKIKRPL,MEM2=KIKRPL,TRK=150,MLQ=KICKSSYS
//SMACLIB  EXEC RECV,MEM=SMACLIB,MEM2=MACLIB,TRK=15,MLQ=KICKSSYS
//SMAPSRC  EXEC RECV,MEM=SMAPSRC,MEM2=MAPSRC,TRK=45,MLQ=KICKSSYS
//SPROCLIB EXEC RECV,MEM=SPROCLIB,MEM2=PROCLIB,TRK=30,MLQ=KICKSSYS
//SPROCLIZ EXEC RECV,MEM=SPROCLIZ,MEM2=PROCLIBZ,TRK=30,MLQ=KICKSSYS
//SSKIKLOD EXEC RECV,MEM=SSKIKLOD,MEM2=SKIKLOAD,TRK=150,MLQ=KICKSSYS
//STESTCOB EXEC RECV,MEM=STESTCOB,MEM2=TESTCOB,TRK=30,MLQ=KICKSSYS
//STESTGCC EXEC RECV,MEM=STESTGCC,MEM2=TESTGCC,TRK=30,MLQ=KICKSSYS
//STESTFIL EXEC RECV,MEM=STESTFIL,MEM2=TESTFILE,TRK=45,MLQ=KICKSSYS
//
