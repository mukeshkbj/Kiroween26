//LSTVTOC JOB (ACCT),'FREE SPACE',CLASS=A,MSGCLASS=A
//S1      EXEC PGM=IEHLIST
//SYSPRINT DD SYSOUT=*
//D1      DD UNIT=3350,VOL=SER=WORK00,DISP=OLD
//D2      DD UNIT=3375,VOL=SER=WORK01,DISP=OLD
//D3      DD UNIT=3390,VOL=SER=WORK03,DISP=OLD
//D4      DD UNIT=3350,VOL=SER=PUB000,DISP=OLD
//D5      DD UNIT=3375,VOL=SER=PUB001,DISP=OLD
//D6      DD UNIT=3390,VOL=SER=PUB003,DISP=OLD
//SYSIN   DD *
 LISTVTOC FORMAT,VOL=3350=WORK00
 LISTVTOC FORMAT,VOL=3375=WORK01
 LISTVTOC FORMAT,VOL=3390=WORK03
 LISTVTOC FORMAT,VOL=3350=PUB000
 LISTVTOC FORMAT,VOL=3375=PUB001
 LISTVTOC FORMAT,VOL=3390=PUB003
/*
//
