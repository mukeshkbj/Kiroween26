//CBSEAND JOB (ACCT),'DEBUG SEANCEM PP',CLASS=A,MSGCLASS=A,REGION=4096K,
//         USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//* Run only the KICKS preprocessor (PP1) on SEANCEM and print the COBOL it
//* generates, so we can see what IKFCBL00 chokes on (it abends S0C4 in COB1).
//COPY   EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=&&PPIN,DISP=(,PASS),UNIT=SYSDA,SPACE=(TRK,(90,15),RLSE)
//SYSUT1   DD DSN=HERC01.KICKS.V1R5M0.COB(SEANCEM),DISP=SHR
//PP1    EXEC PGM=KIKPPCOB,PARM='-v -t -dmapin1'
//STEPLIB  DD DSN=HERC01.KICKSSYS.V1R5M0.SKIKLOAD,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSTERM  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSLIB   DD DISP=SHR,DSN=HERC01.KICKS.V1R5M0.COBCOPY
//         DD DISP=SHR,DSN=HERC01.KICKSSYS.V1R5M0.COBCOPY
//SYSIN    DD DSN=&&PPIN,DISP=(OLD,PASS)
//
