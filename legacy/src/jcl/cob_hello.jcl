//HELOWOB JOB (ACCT),'COBOL HELLO',CLASS=A,MSGCLASS=A,
//             REGION=2048K
//CLG     EXEC COBUCLG
//COB.SYSIN DD *
       IDENTIFICATION DIVISION.
       PROGRAM-ID. HELCOB.
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  WS-MSG        PIC X(30) VALUE 'SPIRITS SAY: HELLO FROM COBOL'.
       PROCEDURE DIVISION.
       MAIN-PARA.
           DISPLAY WS-MSG.
           STOP RUN.
/*
//GO.SYSOUT DD SYSOUT=*
//
