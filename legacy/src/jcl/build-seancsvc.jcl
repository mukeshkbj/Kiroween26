//BLDSVC  JOB (ACCT),'BUILD SEANCSVC',CLASS=A,MSGCLASS=A,REGION=2048K,
//         USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//* Compile + link the SEANCSVC business logic into a permanent load
//* library HERC01.SEANCE.LOAD(SEANCSVC), using the proven OS/VS COBOL
//* path (IKFCBL00 + IEWL). The stand-in then runs this module per request
//* with run-seancsvc.jcl (no recompile). This is the real mainframe COBOL.
//COB     EXEC PGM=IKFCBL00,REGION=2048K,
//         PARM='NODECK,LOAD,SIZE=2048K,BUF=1024K'
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT2   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT3   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSUT4   DD UNIT=SYSDA,SPACE=(460,(700,100))
//SYSLIN   DD DSN=&&LOADSET,DISP=(MOD,PASS),UNIT=SYSDA,
//            SPACE=(80,(500,100))
//SYSIN    DD DSN=HERC01.SEANCE.COB(SEANCSVC),DISP=SHR
//LKED    EXEC PGM=IEWL,PARM='LIST,XREF,LET',COND=(5,LT,COB)
//SYSLIN   DD DSN=&&LOADSET,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=HERC01.SEANCE.LOAD(SEANCSVC),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(1024,(50,20,5))
//SYSLIB   DD DSN=SYS1.COBLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(1024,(50,20))
//SYSPRINT DD SYSOUT=*
//
