//PPSEAN  JOB (ACCT),'PP SEANCEM TO DS',CLASS=A,MSGCLASS=A,REGION=4096K,
//         USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//* Run the KICKS preprocessor (KIKPPCOB) on SEANCEM and keep the generated
//* COBOL as HERC01.SEANCE.PPOUT(SEANCEM), so we can read exactly what the
//* COBOL compiler (IKFCBL00) abends on.
//PP2    EXEC PGM=KIKPPCOB,PARM='-v -t'
//STEPLIB  DD DSN=HERC01.KICKSSYS.V1R5M0.SKIKLOAD,DISP=SHR
//SYSPRINT DD DSN=HERC01.SEANCE.PPOUT(SEANCEM),DISP=(,CATLG),
//            UNIT=SYSDA,SPACE=(TRK,(10,5,5)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SYSTERM  DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSLIB   DD DISP=SHR,DSN=HERC01.KICKS.V1R5M0.COBCOPY
//         DD DISP=SHR,DSN=HERC01.KICKSSYS.V1R5M0.COBCOPY
//SYSIN    DD DISP=SHR,DSN=HERC01.KICKS.V1R5M0.COB(SEANCEM)
//
