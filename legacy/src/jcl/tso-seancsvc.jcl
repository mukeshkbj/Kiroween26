//TSOSVC  JOB (ACCT),'SEANCSVC TSO',CLASS=A,MSGCLASS=A,
//         REGION=4096K,USER=@MVS_USER@,PASSWORD=@MVS_PASSWORD@
//* legacy-environment 6.2: run the line-mode COBOL enquiry SEANCSVC
//* (ACCEPT/DISPLAY, no BMS, no KICKS) UNDER TSO (batch TMP IKJEFT01)
//* with the TSO CALL command; files allocated with TSO ALLOC, as a
//* TSO user at READY would. Read-only: lookup + list.
//TSO     EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD SYSOUT=*
//SYSTSIN  DD *
 PROFILE PREFIX(HERC01)
 ALLOC FI(POLIN)  DA('HERC01.SEANCE.POLICY') SHR
 ALLOC FI(POLOUT) DUMMY
 ALLOC FI(SYSOUT) SYSOUT(A)
 ALLOC FI(SYSIN)  DA('HERC01.SEANCE.TSOREQ(LOOKUP)') SHR
 CALL 'HERC01.SEANCE.LOAD(SEANCSVC)'
 FREE FI(SYSIN)
 ALLOC FI(SYSIN)  DA('HERC01.SEANCE.TSOREQ(LIST)') SHR
 CALL 'HERC01.SEANCE.LOAD(SEANCSVC)'
 FREE FI(SYSIN POLIN POLOUT SYSOUT)
/*
//
