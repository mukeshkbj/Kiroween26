# seance-agent environment (placeholders only; copy to .env, which is gitignored).
# No real key, host, port or credential belongs in this file or in the repo.

# -- service / transport ----------------------------------------------------
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
# Comma-separated list of browser origins allowed to reach REST + websocket.
AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Turn budgets.
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_ERRORS=3
AGENT_TURN_TIMEOUT_S=120
# on = offer the generic read_screen/list_fields/fill_field/press_key tools too.
AGENT_GENERIC_TOOLS=on
# Optional JSONL event log (gitignored). Leave unset to disable.
AGENT_EVENT_LOG=
# Ring buffer size for resume.
AGENT_RING_SIZE=1000

# -- LLM provider (contracts section 9) -------------------------------------
# anthropic | bedrock | scripted  (unknown value is a startup error)
LLM_PROVIDER=scripted
LLM_MODEL=scripted-demo
# Anthropic: key is never logged, never placed in an event or error message.
ANTHROPIC_API_KEY=
# Bedrock: region; credentials come from the standard AWS credential chain.
AWS_REGION=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=60

# -- shared with mcp-server -------------------------------------------------
TN3270_HOST=
TN3270_PORT=
# 0 = read-only (approval ends blocked_read_only); 1 = commits allowed.
SEANCE_ALLOW_COMMIT=0
# The UI modal is the human gate.
SEANCE_CONFIRM_MODE=oob
PENDING_TTL_S=300
AUDIT_LOG_PATH=docs/audit/audit.jsonl
# Generated tool pack + approved key policy for the connected app.
GENERATED_TOOLS_PATH=
TOOL_APPROVALS_PATH=
KEY_POLICY_PATH=
# Must be 1 before the agent will connect to a live host. Never set in a shared .env.
GSS_LIVE_OK=
