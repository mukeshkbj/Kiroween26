# 3270 host (the TK4- legacy container)
TN3270_HOST=localhost
TN3270_PORT=3270
WAIT_TIMEOUT_MS=5000

# Commits are off unless the operator turns them on (1). The model cannot change this.
SEANCE_ALLOW_COMMIT=0
# Who confirms a commit: elicit (default for external clients like Kiro),
# oob (our web UI's confirmation modal; the demo path), or client-approval
# (explicit opt-in only, weakest: relies on the client's own tool approval).
SEANCE_CONFIRM_MODE=elicit
# A pending action expires after this many seconds.
PENDING_TTL_S=300
# Append-only, hash-chained audit log (gitignored).
AUDIT_LOG_PATH=docs/audit/audit.jsonl
# Spans (row,col,len; 0-origin, ';'-separated) masked out of screen_id. Default is the
# TK4- welcome Date/Time clock (0,64,16;1,64,16). Use "none" to disable.
VOLATILE_REGIONS=
# Optional JSON: {screen_id: {"read_only_keys": ["PF3", "PF7"]}}
KEY_POLICY_PATH=
