# LLM provider for labelling (docs/contracts.md section 9). Placeholders only.
# heuristic = no LLM, labels derived from on-screen text. anthropic | bedrock | heuristic
LLM_PROVIDER=heuristic
LLM_MODEL=
ANTHROPIC_API_KEY=
AWS_REGION=
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=60

# Live runs are Agent A / integrator only (docs/contracts.md section 2.1). Never set this in a shared .env.
GSS_LIVE_OK=0
